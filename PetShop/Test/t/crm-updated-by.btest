test_setup('PetShop');
home_page();
my($tech) = 'crm_tech1';
my($user) = 'demo';
my($updated_by, $from) = ('Updated by', 'Initiated by');
my($name, $uri) = create_crm_forum([$tech]);
my($email) = generate_remote_email($name);
my($cust1) = generate_local_email('crm_cust1');
my($tech1) = generate_local_email($tech);
my($user_email) = generate_local_email($user);
my($by_tech, $by_root, $by_none, $by_user) = map({
    my($body) = ${send_mail($_, $email)->get_body};
    (verify_local_mail($tech1, qr{\Q$body}, 1) =~ m{^Subject: .*#(\d+)\]}mi)[0];
} ($cust1) x 3, $user_email);
die('no ticket')
    unless $by_tech && $by_root && $by_none && $by_user;
my($tickets) = sub {
    visit_uri($uri);
    follow_link('tickets');
    return;
};
my($update) = sub {
    my($num) = @_;
    $tickets->();
    follow_link(qr{^$num$});
    submit_form(only => {status => 'Open'});
    verify_local_mail($tech1, qr{Status changed from New to Open}, 1);
    return;
};
my($cell) = sub {
    my($num, $heading) = @_;
    return find_table_row('Ticket', 'Ticket', qr{^$num$})->{$heading};
};
my($assert_text) = sub {
    my($num, $heading, $text) = @_;
    my($c) = $cell->($num, $heading);
    test_equals($text, $c->as_string);
    test_equals([], $c->get('Links')->get_keys);
    return;
};
my($assert_su_link) = sub {
    my($num, $heading, $text) = @_;
    my($c) = $cell->($num, $heading);
    test_equals(qr{\Q$text\E}, $c->as_string);
    test_equals([$c->as_string], $c->get('Links')->get_keys);
    my($su_uri) = get_link_in_table('Ticket', 'Ticket', qr{^$num$}, $heading);
    test_equals(qr{^/adm/su\?t=\d+$}, $su_uri);
    verify_text(qr{<a target="_blank" href="\Q$su_uri\E">[^<]*\Q$text\E</a>});
    return $su_uri;
};
$update->($by_root);
do_logout();
visit_uri('/bp');
login_as($tech);
$update->($by_tech);
$tickets->();
$assert_text->($by_tech, $updated_by, qr{\Q$tech\E});
$assert_text->($by_root, $updated_by, qr{root});
$assert_text->($by_none, $updated_by, '');
$assert_text->($by_none, $from, qr{\Q$cust1\E});
$assert_text->($by_user, $from, qr{\Q$user_email\E});
do_logout();
visit_uri('/bp');
login_as('root');
$tickets->();
$assert_text->($by_root, $updated_by, qr{root});
$assert_text->($by_none, $updated_by, '');
$assert_text->($by_none, $from, qr{\Q$cust1\E});
test_equals(
    $assert_su_link->($by_user, $updated_by, $user),
    $assert_su_link->($by_user, $from, $user_email),
);
my($su_uri) = $assert_su_link->($by_tech, $updated_by, $tech);
visit_uri($su_uri);
verify_text(qr{Acting as User:<br\s*/?>\Q$tech\E<});
