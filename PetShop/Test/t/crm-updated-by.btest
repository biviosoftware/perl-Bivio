test_setup('PetShop');
home_page();
my($tech) = 'crm_tech1';
my($name, $uri) = create_crm_forum([$tech]);
my($email) = generate_remote_email($name);
my($cust1) = generate_local_email('crm_cust1');
my($tech1) = generate_local_email($tech);
my($by_tech, $by_root, $by_none) = map({
    my($body) = ${send_mail($cust1, $email)->get_body};
    (verify_local_mail($tech1, qr{\Q$body}, 1) =~ m{^Subject: .*#(\d+)\]}mi)[0];
} 1..3);
die('no ticket')
    unless $by_tech && $by_root && $by_none;
my($tickets) = sub {
    visit_uri($uri);
    follow_link('tickets');
    return;
};
my($update) = sub {
    my($num) = @_;
    $tickets->();
    follow_link(qr{^$num$});
    submit_form(only => {status => 'Open'});
    verify_local_mail($tech1, qr{Status changed from New to Open}, 1);
    return;
};
my($updated_by) = sub {
    my($num) = @_;
    return find_table_row('Ticket', 'Ticket', qr{^$num$})->{'Updated by'};
};
my($assert_text) = sub {
    my($num, $text) = @_;
    my($cell) = $updated_by->($num);
    test_equals($text, $cell->as_string);
    test_equals([], $cell->get('Links')->get_keys);
    return;
};
$update->($by_root);
do_logout();
visit_uri('/bp');
login_as($tech);
$update->($by_tech);
$tickets->();
$assert_text->($by_tech, qr{\Q$tech\E});
$assert_text->($by_root, qr{root});
$assert_text->($by_none, '');
do_logout();
visit_uri('/bp');
login_as('root');
$tickets->();
$assert_text->($by_root, qr{root});
$assert_text->($by_none, '');
my($tech_cell) = $updated_by->($by_tech);
test_equals(qr{\Q$tech\E}, $tech_cell->as_string);
test_equals([$tech_cell->as_string], $tech_cell->get('Links')->get_keys);
my($su_uri) = get_link_in_table('Ticket', 'Ticket', qr{^$by_tech$}, 'Updated by');
test_equals(qr{^/adm/su\?}, $su_uri);
verify_text(qr{<a target="_blank" href="\Q$su_uri\E">[^<]*\Q$tech\E</a>});
visit_uri($su_uri);
verify_text(qr{Acting as User:<br\s*/?>\Q$tech\E<});
