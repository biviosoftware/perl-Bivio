test_setup('PetShop');
home_page();
my($tech) = 'crm_tech1';
my($name, $uri) = create_crm_forum([$tech]);
do_logout();
visit_uri('/bp');
login_as($tech);
my($email) = generate_remote_email($name);
my($cust1) = generate_local_email('crm_cust1');
my($tech1) = generate_local_email($tech);
my($to_close, $to_keep) = map({
    my($body) = ${send_mail($cust1, $email)->get_body};
    (verify_local_mail($tech1, qr{\Q$body}, 1) =~ m{^Subject: .*#(\d+)\]}mi)[0];
} 1..2);
die('no ticket')
    unless $to_close && $to_keep;
visit_uri($uri);
follow_link('tickets');
follow_link(qr{^$to_close$});
submit_form(only => {status => 'Closed'});
verify_local_mail($tech1, qr{\Q$email\E.*Status changed from New to Closed}s, 1);
my($tickets) = sub {
    my($res) = [];
    do_table_rows('Ticket', sub {
        my($row) = @_;
        push(@$res, $row->{Ticket}->as_string)
            if $row->{Status};
        return 1;
    });
    return $res;
};
my($lookup) = sub {
    my($num) = @_;
    submit_form(refresh => {_anon => $num});
    return;
};
test_equals([$to_keep], $tickets->());
$lookup->($to_close);
test_equals([$to_close], $tickets->());
do_table_rows('Ticket', sub {
    my($row) = @_;
    test_equals(qr{closed}i, $row->{Status})
        if $row->{Status};
    return 1;
});
$lookup->($to_keep + 1);
verify_text('list is empty');
test_deviance(qr{number without a decimal point});
$lookup->('not-a-number');
test_conformance();
