Type();
use Encode ();
my($value) = '&lt; original/value%20 &gt;';
my($copy) = $value;
my($nnbsp) = "a\x{202F}b";
my($nnbsp_escaped) = 'a%E2%80%AFb';
my($e_acute) = Encode::decode_utf8("caf\xc3\xa9");
my($e_acute_escaped) = 'caf%C3%A9';

[
    # $] > 5.008005 ? () : (
    #         escape => [
    #             "'" => '&#39;',
    #             '"' => '&#x22;',
    #             #http://www.dwheeler.com/essays/quotes-in-html.html
    #             #http://www.alistapart.com/articles/emen/
    #             '“' => '&#x201C;',
    #             '”' => '&#x201D;',
    #             '‘' => '&#x2018;',
    #             '’' => '&#x2019;',
    #             '—' => '&#x2014;', #em dash
    #             '–' => '&#x2013;', #en dash
    #             '™' => '&#x2122;',
    #             '®' => '&#xAE;',
    #             '©' => '&#xA9;',
    #             '§' => '&#xA7;',
    #             'ö' => '&#xF6;',
    #             "\x{201C}" => '&#x201C;',
    #         ],
    # ),
    escape_query => [
        hello => 'hello',
        'hello+bye' => 'hello%2Bbye',
        'hello bye' => 'hello%20bye',
        'hello&bye' => 'hello%26bye',
        'hello?bye' => 'hello%3Fbye',
        $nnbsp => $nnbsp_escaped,
    ],
    escape_uri => [
        'hello bye' => 'hello%20bye',
        '/a/b c' => '/a/b%20c',
        'a=b&c' => 'a%3Db%26c',
        $nnbsp => $nnbsp_escaped,
        Encode::encode_utf8($nnbsp) => $nnbsp_escaped,
        $e_acute => $e_acute_escaped,
        Encode::encode_utf8($e_acute) => $e_acute_escaped,
    ],
    unescape_query => [
        hello => 'hello',
        'hello%2Bbye' => 'hello+bye',
        'hello%20bye' => 'hello bye',
        'hello%26bye' => 'hello&bye',
        'hello%3Fbye' => 'hello?bye',
    ],
    unescape => [
        [undef] => '',
        hello => 'hello',
        '&#39;' => q{'},
        '&amp;&gt;&lt;&quot;' => q{&><"},
        '&copy;' => "\x{00A9}",
        '&trade;' => "\x{2122}",
        '&#x201C;' => "\x{201C}",
        map(($_->[0], Encode::decode_utf8($_->[1])),
            ['&#x201C;' => '“'],
            ['&#x201D;' => '”'],
            ['&#x2018;' => '‘'],
            ['&#x2019;' => '’'],
            ['&#x2014;' => '—'], #em dash
            ['&#x2013;' => '–'], #en dash
            ['&#x2122;' => '™'],
            ['&#xAE;' => '®'],
            ['&#xA9;' => '©'],
            ['&#xA7;' => '§'],
        ),
    ],
    parse_www_form_urlencoded => [
        [undef] => [{}],
        '' => [{}],
        'a=1' => [{a => 1}],
        'a&b' => [{a => undef, b => undef}],
        'a;b' => [{a => undef, b => undef}],
        'a&b=1' => [{a => undef, b => 1}],
        'a;b=1&c=2' => [{a => undef, b => 1, c => 2}],
        'a=1;' => [{a => 1}],
        'a=1&' => [{a => 1}],
        '&' => [{}],
        ';' => [{}],
        ';a=1' => [{a => 1}],
        'a&=1' => CORRUPT_FORM(),
        '=' => CORRUPT_FORM(),
    ],
    sub {
        class()->escape($value);
        class()->unescape($value);
        class()->escape_uri($value);
        class()->unescape_uri($value);
        return $value eq $copy ? 1 : 0;
    } => 1,
];
