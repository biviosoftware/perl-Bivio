Request();
my($select_pid) = 'select pg_backend_pid()';
my($pid);
my($save_pid) = sub {
    my(undef, $actual) = @_;
    $pid = $actual->[0]->[0];
    return 1;
};
my($new_pid) = sub {
    my(undef, $actual) = @_;
    assert_not_equals($pid, $actual->[0]->[0]);
    return $save_pid->(undef, $actual);
};
my($terminate_backend) = sub {
    my($dbh) = Ext_DBI()->connect;
    $dbh->selectrow_array('select pg_terminate_backend(?)', undef, $pid);
    foreach my $try (1 .. 50) {
        $dbh->rollback;
        last
            unless $dbh->selectrow_array(
                'select count(*) from pg_stat_activity where pid = ?', undef, $pid);
        $dbh->selectrow_array('select pg_sleep(0.1)');
    }
    $dbh->rollback;
    $dbh->disconnect;
    return;
};
[
    class() => [
        execute_one_row => [
            [$select_pid] => $save_pid,
        ],
        inline_commit(),
        inline_case($terminate_backend),
        execute_one_row => [
            [$select_pid] => $new_pid,
            [$select_pid] => $save_pid,
        ],
        inline_case($terminate_backend),
        execute_one_row => [
            [$select_pid] => DB_ERROR(),
        ],
        inline_rollback(),
        execute_one_row => [
            [$select_pid] => $new_pid,
        ],
    ],
];
