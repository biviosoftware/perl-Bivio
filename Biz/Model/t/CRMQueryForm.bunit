FormModel();
my($num) = 3;
my($open) = CRMThreadStatus('OPEN');
[
    empty_case({
        b_status => $open,
        b_owner_name => undef,
    }),
    req_state({
        query => {
            b_crm_thread_num => $num,
            b_status => CRMThreadStatus('CLOSED')->as_int,
            b_owner => realm_id('crm_tech1'),
        },
    }),
    empty_case({
        b_crm_thread_num => $num,
        b_status => undef,
        b_owner => undef,
    }),
    req_state({
        query => {
            b_crm_thread_num => 'not-a-number',
        },
    }),
    empty_case({
        b_crm_thread_num => 'INTEGER',
        b_status => $open,
    }),
];
