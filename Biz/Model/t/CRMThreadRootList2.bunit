ListModel();
my($tech) = 'crm_tech1';
req()->set_realm_and_user('crm_tuple_forum', $tech)->initialize_fully('FORUM_CRM_FORM');
CRMThread()->test_unauth_delete_all({realm_id => req('auth_id')});
my($num) = {map({
    my($status) = $_;
    ShellUtil_TestCRM()->create_thread({
        crm_thread_status => CRMThreadStatus($status),
        'b_ticket.TupleTag.slot2' => 'High',
    });
    ($status => req(qw(Model.CRMThread crm_thread_num)));
} qw(CLOSED OPEN))};
options({
    compute_params => sub {
        my(undef, $params) = @_;
        req()->put(query => {@$params}, form => undef);
        model('CRMQueryForm')->process;
        return [];
    },
});
[
    load_all => [
        [] => [{
            'CRMThread.crm_thread_num' => $num->{OPEN},
        }],
        [b_crm_thread_num => $num->{CLOSED}] => [{
            'CRMThread.crm_thread_num' => $num->{CLOSED},
            'CRMThread.crm_thread_status' => CRMThreadStatus('CLOSED'),
        }],
        [
            b_crm_thread_num => $num->{CLOSED},
            b_status => CRMThreadStatus('OPEN')->as_int,
            b_owner => realm_id($tech),
            b_priority => 'Low',
        ] => [{
            'CRMThread.crm_thread_num' => $num->{CLOSED},
        }],
        [b_crm_thread_num => $num->{OPEN} + 1] => [],
    ],
];
